# ============================================================
# ZETOPS 用户配置文件示例 [Config Example]
# 安装时由 install.sh 复制到 ~/.zetops/zetops.conf
# 修改后重启 zetops 生效；所有字段均可选
# ============================================================

# ---- 通用配置 ----
# 日志目录（需 root 写入权限）
LOG_DIR="/var/log/zetops"
# 日志级别：DEBUG < INFO < WARNING < ERROR
LOG_LEVEL="INFO"
# 备份默认目录
BACKUP_DIR="/data/backup"
# 数据默认目录
DATA_DIR="/data"

# ---- MySQL 默认配置 [Database] ----
MYSQL_VERSION="8.0"
MYSQL_DATA_DIR="/data/mysql"
MYSQL_PORT="3306"

# ---- PostgreSQL 默认配置 ----
PG_VERSION="16"
PG_DATA_DIR="/var/lib/postgresql"

# ---- Redis 默认配置 ----
REDIS_PORT="6379"

# ---- Docker 容器配置 [Container] ----
DOCKER_REGISTRY="docker.io"
DOCKER_DATA_DIR="/var/lib/docker"

# ---- OpenAI/LLM 配置 [AI Assistant] ----
# 配置后 AI 智能运维助手自动启用大模型对话（纯 Bash curl 调用，流式输出）
# 留空 OPENAI_API_KEY 则使用内置无网规则引擎（10+ 场景关键词诊断）
# 兼容 OpenAI 接口的任意服务均可使用（官方/第三方代理/DeepSeek/Qwen 等）
# 格式：OPENAI_API_KEY="sk-xxxxx"     （不保存 token，仅用于请求鉴权）
OPENAI_API_KEY=""
# 接口地址：官方 https://api.openai.com/v1 ；国内中转/兼容服务填对应地址
OPENAI_BASE_URL="https://api.openai.com/v1"
# 模型名：gpt-4o-mini / gpt-4o / deepseek-chat / qwen-plus ...
OPENAI_MODEL="gpt-4o-mini"
# 单次请求超时（秒）
OPENAI_TIMEOUT="120"
# 函数调用开关：on=AI 可调用工具获取系统真实状态/申请执行命令；off=仅纯文本对话
OPENAI_TOOLS="on"

# ---- 监控/告警 ----
MONITOR_ALERT_EMAIL=""

# ---- 自我更新配置 [Self Update] ----
# 工具箱整体版本号（升级后自动更新）
ZETOPS_VERSION="1.4.1"
# GitHub 仓库地址（自我更新拉取来源）
ZETOPS_REPO_URL="https://github.com/kuangxing6367/zc-easy-term-ops.git"
# 更新分支
ZETOPS_UPDATE_BRANCH="main"
# GitHub 加速镜像前缀（国内加速，如 https://ghfast.top/ ；留空=直连 GitHub）
ZETOPS_GITHUB_MIRROR=""
