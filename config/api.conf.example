# ============================================================
# ZETOPS API 节点配置文件 [API Config]
# 安装时由 install.sh 复制到 ~/.zetops/api.conf
# 所有外部数据（镜像源列表/NTP服务器/Docker安装脚本/配置模板）
# 均从此 API 节点动态获取，不硬编码
# ============================================================

# API 节点基础地址（形如 https://your.api.node/v1）
# 留空则使用各模块内置的默认官方源
API_BASE_URL=""

# API 请求超时时间（秒）
API_TIMEOUT=10
