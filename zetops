#!/bin/bash
set -euo pipefail

# 解析 symlink，获取真实脚本所在目录
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
    DIR="$(cd "$(dirname "${SOURCE}")" && pwd)"
    SOURCE="$(readlink "${SOURCE}")"
    [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
ZETOPS_HOME="$(cd "$(dirname "${SOURCE}")" && pwd)"

exec bash "${ZETOPS_HOME}/core/main.sh" "$@"
